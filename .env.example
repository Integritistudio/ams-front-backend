PORT=3303
NODE_ENV=development

# Recommended (password may contain @ # / without encoding)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=integriti_helpdesk
DB_SSL=false

# Or use a single URL (encode special chars: @ → %40)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/integriti_helpdesk

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3001
# Optional extra allowed origins (comma-separated)
# FRONTEND_URLS=http://127.0.0.1:3001

# SMTP is configured in Admin → Email Settings (not via .env)
UPLOAD_DIR=uploads
COOKIE_SECURE=false

# Production: set NODE_ENV=production (seed is blocked).
# Never set ALLOW_SEED=true on production.
#
# Optional local-only seed passwords (never commit real values; leave empty for NULL hashes):
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
# Disposable inbox domain for seed users (default getnada.com):
# SEED_EMAIL_DOMAIN=getnada.com
