PORT=3303
NODE_ENV=development

# Recommended (password may contain @ # / without encoding)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=integriti_helpdesk
DB_SSL=false

# Or use a single URL (encode special chars: @ → %40)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/integriti_helpdesk

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3001
# Optional extra allowed origins (comma-separated)
# FRONTEND_URLS=http://127.0.0.1:3001

# SMTP is configured in Admin → Email Settings (not via .env)
# Legacy disk folder (no longer used for new uploads — files go encrypted into Postgres)
UPLOAD_DIR=uploads
COOKIE_SECURE=false

# Required for ticket/requisition/avatar attachments (AES-256-GCM in Postgres).
# Without this, uploads with files are rejected so documents are never stored with a guessable fallback key.
# Use a long random secret (min 16 chars). Keep it stable — changing it makes old attachments unreadable.
FILE_ENCRYPTION_KEY=change-me-to-a-long-random-file-encryption-secret

# OpenAI "Improve with AI" — prefer Admin → Settings (stored in DB).
# OPENAI_API_KEY= is only an optional fallback if no UI key is set.
# OPENAI_MODEL=gpt-4o-mini

# Super Admin (single locked person). Required for Settings / Email Settings / HR·GM limits.
# On migrate: creates Super Admin role + this user if none exists yet.
# SUPER_ADMIN_EMAIL=you@company.com
# SUPER_ADMIN_NAME=Your Name
#
# Password — pick ONE:
# A) Local quick start: set a password in env (remove after first login)
#    SUPER_ADMIN_PASSWORD=ChangeMeLocally123
# B) Recommended (local + production): leave password empty → migrate prints a one-time
#    setup URL (and emails it if SMTP is already working). Open:
#    http://localhost:3001/setup-password?token=…
# SUPER_ADMIN_FORCE=1            # only to re-bind Super Admin to SUPER_ADMIN_EMAIL
# SUPER_ADMIN_FORCE_PASSWORD=1   # overwrite existing hash from SUPER_ADMIN_PASSWORD

# Production: set NODE_ENV=production (seed is blocked).
# Never set ALLOW_SEED=true on production.
#
# Optional local-only seed passwords (never commit real values; leave empty for NULL hashes):
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
# Disposable inbox domain for seed users (default getnada.com):
# SEED_EMAIL_DOMAIN=getnada.com
